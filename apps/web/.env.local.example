# --- Phase 0 web app environment ---

# Official GOV.UK booking entry point. Learners check/manage their own test here.
NEXT_PUBLIC_GOVUK_BOOKING_URL=https://www.gov.uk/book-driving-test

# Canonical site URL (used by metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: waitlist persistence ---
# If these are set, the waitlist API writes to a Supabase `waitlist` table.
# If unset (default), entries append to apps/web/.data/waitlist.json for local dev.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
