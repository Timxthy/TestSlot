# TestSlot Radar — web app environment.
# Copy to .env.local for local dev. NEVER commit real values (.env.local is gitignored).
#
# MOCK MODE vs LIVE MODE (see lib/supabase/config.ts):
#   - Leave ALL FOUR Supabase vars unset -> mock mode (seeded in-memory data,
#     waitlist falls back to apps/web/.data/waitlist.json).
#   - Set ALL FOUR together               -> live mode (real Supabase).
#   - Partial config throws at startup, on purpose.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOVUK_BOOKING_URL=https://www.gov.uk/book-driving-test
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable key (sb_publishable_...)

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # secret key (sb_secret_...) — bypasses RLS

# --- Chunk B: notification delivery (scaffolded, inert until set) ---
# RESEND_API_KEY=                     # Resend transactional email key
# RESEND_FROM=TestSlot Radar <notifications@yourdomain>   # must be a Resend-verified domain
# CRON_SECRET=                        # shared secret protecting /api/cron/deliver-notifications
# UNSUBSCRIBE_SECRET=                 # signs one-click email unsubscribe links (falls back to CRON_SECRET)
